# Copier vers .env.local pour le développement, ou renseigner dans Coolify en production.
# Ne jamais commiter de valeur réelle.

# Obligatoire en production. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse publique du site, sans slash final.
BETTER_AUTH_URL=https://craftly.projectp.fr
# Chemin de la base SQLite. En production, le volume monté sur /data.
DATABASE_PATH=/data/craftly.db
